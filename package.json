{
  "name": "deckprobe",
  "private": true,
  "description": "DeckProbe — Steam Deck plugin toolkit (CDP probes, screenshot pipeline, perf bench).",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "python": ">=3.10"
  },
  "scripts": {
    "cli": "node scripts/py.mjs cli.py",
    "probe": "node scripts/py.mjs cli.py probe",
    "screenshots": "node scripts/py.mjs cli.py screenshot",
    "diag": "node scripts/py.mjs cli.py diag list",
    "diag:run": "node scripts/py.mjs cli.py diag run",
    "perf:bench": "node scripts/py.mjs perf-bench.py",
    "uitests": "cd .. && node deckprobe/scripts/py.mjs -m deckprobe.uitests.run",
    "uitests:list": "cd .. && node deckprobe/scripts/py.mjs -m deckprobe.uitests.run --list",
    "update": "pnpm update --latest && pnpm install",
    "update:check": "pnpm outdated || true"
  }
}
